# 前端环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 后端 API 根地址（不要末尾 /；请求路径仍为 /api/v1/...）
# 开发：留空 → 使用 vite.config.js 里 proxy，将 /api 转发到线上机
# 若直连其它后端，例如：VITE_API_BASE_URL=http://127.0.0.1:8003
# 生产构建未设置时，代码内默认 http://101.200.1.56
VITE_API_BASE_URL=

# 应用配置
# VITE_APP_TITLE=Nexus
# VITE_APP_VERSION=1.0.0

# 其他配置
# VITE_ENABLE_DEBUG=true
