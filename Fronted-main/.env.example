# 前端环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 后端 API 根地址（不要末尾 /；请求路径仍为 /api/v1/...）
# 云端默认：http://101.200.1.56（与 Android network_security_config 放行域名一致）
# 开发：留空 → vite.config.js 将 /api 代理到 101.200.1.56
# 本地直连后端示例：VITE_API_BASE_URL=http://127.0.0.1:8003
# 生产构建：见 .env.production；未设置时 http.js 内默认仍为 http://101.200.1.56
VITE_API_BASE_URL=

# 可选：静态视频根（仅当与 API 不同源时）。不填则与 VITE_API_BASE_URL 同源（推荐与 FastAPI 同端口）
# VITE_VIDEO_ORIGIN=http://101.200.1.56:8003

# 可选：仅本地 pnpm dev 时，覆盖 Vite 对 /api、/videos 的代理目标（默认同上云端；本地后端示例见下行）
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8003

# Android：同步 Web 资源到工程用 pnpm run build:mobile:android；需要 APK 再加 pnpm run build:mobile:android:apk
# 微信小程序：见 .env.miniprogram；H5 构建 pnpm run build:mobile:miniprogram:h5，入口 URL 写入 miniprogram/config/runtime.js 用 pnpm run build:mobile:miniprogram:config
# MINIPROGRAM_H5_URL=https://你的HTTPS域名/

# 应用配置
# VITE_APP_TITLE=Nexus
# VITE_APP_VERSION=1.0.0

# 其他配置
# VITE_ENABLE_DEBUG=true
