{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-internal-toggle-devtools",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:path:default",
    "core:webview:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://101.200.1.56" },
        { "url": "http://101.200.1.56/**" },
        { "url": "https://101.200.1.56" },
        { "url": "https://101.200.1.56/**" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
