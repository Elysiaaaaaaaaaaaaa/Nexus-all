{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "nexus-best",
  "version": "0.1.0",
  "identifier": "com.nexus.best",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Nexus",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://101.200.1.56 https://101.200.1.56 http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "style-src": "'unsafe-inline' 'self'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://101.200.1.56 https://101.200.1.56 http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data: http: https:",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
