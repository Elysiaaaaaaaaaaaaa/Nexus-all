# 微信小程序内嵌 H5：无 Vite 代理，需写完整 API 源（与 .env.tauri 类似）
VITE_API_BASE_URL=http://101.200.1.56
VITE_RUNTIME_CHANNEL=wechat_miniprogram

# H5 若部署在子路径，例如 https://cdn.com/nexus/，则设为 /nexus/
# VITE_MINIPROGRAM_BASE=/nexus/

# 供 scripts/build/write-miniprogram-runtime.mjs 读取：部署 dist-miniprogram 后的 HTTPS 根地址（须与业务域名一致）
# MINIPROGRAM_H5_URL=https://your-domain.com/
